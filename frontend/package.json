{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"test": "vitest",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@eslint/compat": "^2",
		"@eslint/js": "^10",
		"@lucide/svelte": "1.0",
		"@sveltejs/adapter-static": "^4.0",
		"@sveltejs/kit": "^3.2",
		"@sveltejs/vite-plugin-svelte": "^7.3",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5",
		"@tailwindcss/vite": "4.3",
		"@types/big.js": "^7.0",
		"@types/node": "^24",
		"@vite-pwa/sveltekit": "^2.0.0",
		"@vitest/coverage-istanbul": "^5",
		"daisyui": "^5.7",
		"eslint": "^10.0",
		"eslint-plugin-svelte": "^3.24",
		"fake-indexeddb": "^6.2",
		"globals": "^17",
		"svelte": "^5.57",
		"svelte-check": "4.7",
		"tailwindcss": "4.3",
		"typescript": "^6.0",
		"typescript-eslint": "8.72",
		"vite": "8.3",
		"vitest": "^5.1",
		"workbox-precaching": "^7.4.1"
	},
	"dependencies": {
		"big.js": "^7.0",
		"dexie": "^4.4",
		"uuid": "^14"
	},
	"imports": {
		"#lib/*": "./src/lib/*.ts",
		"#stores/*": "./src/stores/*.ts",
		"#components/*": "./src/components/*"
	}
}
